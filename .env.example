# MedVision AI local environment template.
# Copy to .env for local development and replace placeholders with local values.

APP_NAME="MedVision AI"
APP_VERSION=0.1.0
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL SQLAlchemy URL. Do not commit real credentials.
DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@localhost:5432/medvision_ai

# Docker Compose local database placeholders.
POSTGRES_DB=medvision_ai
POSTGRES_USER=<db_user>
POSTGRES_PORT=5432
# POSTGRES_PASSWORD=<db_password>

# Frontend.
VITE_API_BASE_URL=http://localhost:8000
